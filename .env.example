SUPABASE_PUBLISHABLE_KEY="[NEW_SUPABASE_PUBLISHABLE_KEY]"
SUPABASE_URL="[NEW_SUPABASE_PROJECT_URL]"
VITE_SUPABASE_PROJECT_ID="[NEW_SUPABASE_PROJECT_ID]"
VITE_SUPABASE_PUBLISHABLE_KEY="[NEW_SUPABASE_PUBLISHABLE_KEY]"
VITE_SUPABASE_URL="[NEW_SUPABASE_PROJECT_URL]"

# Required for the "Enable Portal" feature (server.js creates the client's Supabase Auth
# login here, which needs admin/service-role privileges). NEVER expose this to the browser
# and never prefix it with VITE_. Get it from: Supabase Dashboard > Project Settings > API
# > service_role secret. This file is now gitignored — do not commit this key.
SUPABASE_SERVICE_ROLE_KEY="[NEW_SUPABASE_SERVICE_ROLE_KEY]"
OPENAI_API_KEY="[NEW_OPENAI_API_KEY]"

# Where the browser gets sent back to after connecting/disconnecting. Vite dev
# server default is port 8080 (see vite.config.ts) — change if yours differs.
FRONTEND_URL="http://localhost:8080"

# Required for the Zoho Calendar / Meeting integration (appointments auto-scheduled
# on the practitioner's Zoho account). One-time setup:
#   1. https://api-console.zoho.in/ (use the same Zoho data centre as your account,
#      e.g. .com/.eu instead of .in, and set ZOHO_ACCOUNTS_URL / ZOHO_CALENDAR_API to match).
#   2. Add Client -> "Server-based Applications".
#   3. Homepage URL: http://localhost:8080
#      Authorized Redirect URI: http://localhost:3000/api/zoho/oauth/callback
#      (add your production backend URL + /api/zoho/oauth/callback too once deployed).
#   4. Copy the generated Client ID and Client Secret below.
# Then restart `npm run api` and connect from the Appointments page in the app.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/zoho/oauth/callback
# Only change these if your Zoho account is not on the India (.in) data centre:
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# ZOHO_CALENDAR_API=https://calendar.zoho.in/api/v1
